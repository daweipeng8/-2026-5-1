import cv2
import serial
import time
import numpy as np
import os

# =========================
# 串口配置
# =========================
SERIAL_PORT = 'COM3'      # 改成你的实际串口，例如 COM5
BAUDRATE = 115200
TRIGGER_DISTANCE = 250    # 小于250触发
TRIGGER_COOLDOWN = 1.0    # 触发冷却时间，防止连续误触发

# =========================
# 屏幕配置
# 4个连续扩展屏，每个1920x1080
# 如果屏幕排列不同，这里改坐标
# =========================
SCREEN_W = 1920
SCREEN_H = 1080

WINDOW_NAMES = ["Screen1", "Screen2", "Screen3", "Screen4"]
WINDOW_POSITIONS = [
    (0, 0),
    (1920, 0),
    (3840, 0),
    (5760, 0)
]

# =========================
# 视频配置
# =========================
VIDEO_BASE_DIR = r"D:\\"
IDLE_VIDEO = os.path.join(VIDEO_BASE_DIR, "传送带-空.mp4")
TOTAL_GROUPS = 4   # 1~4组循环

# =========================
# 创建窗口
# =========================
def create_windows():
    for name, pos in zip(WINDOW_NAMES, WINDOW_POSITIONS):
        cv2.namedWindow(name, cv2.WINDOW_NORMAL)
        cv2.moveWindow(name, pos[0], pos[1])
        cv2.setWindowProperty(name, cv2.WND_PROP_FULLSCREEN, cv2.WINDOW_FULLSCREEN)

# =========================
# 串口自动连接
# =========================
def open_serial():
    while True:
        try:
            ser = serial.Serial(SERIAL_PORT, BAUDRATE, timeout=0.001)
            print(f"串口连接成功: {SERIAL_PORT}")
            time.sleep(0.2)
            ser.reset_input_buffer()
            return ser
        except Exception as e:
            print("等待串口连接...", e)
            time.sleep(1)

# =========================
# 非阻塞读取距离
# =========================
def read_distance(ser):
    if ser.in_waiting <= 0:
        return None

    data = ser.read(ser.in_waiting).decode(errors='ignore')
    lines = data.splitlines()
    if not lines:
        return None

    last_line = lines[-1].strip()
    if not last_line:
        return None

    return int(last_line)

# =========================
# 安全读取距离
# 串口断开自动重连
# =========================
def get_distance_safe(ser):
    try:
        distance = read_distance(ser)
        return distance, ser
    except Exception as e:
        print("串口异常，正在重连...", e)
        try:
            ser.close()
        except:
            pass
        ser = open_serial()
        return None, ser

# =========================
# 获取视频帧延时
# =========================
def get_video_delay(cap, default_fps=30):
    fps = cap.get(cv2.CAP_PROP_FPS)
    if fps <= 1 or fps > 240:
        fps = default_fps
    delay = int(1000 / fps)
    return max(delay, 1)

# =========================
# 四屏显示
# =========================
def show_frames(frames):
    for i in range(4):
        cv2.imshow(WINDOW_NAMES[i], frames[i])

# =========================
# 黑屏
# =========================
def create_black_frame():
    return np.zeros((SCREEN_H, SCREEN_W, 3), dtype=np.uint8)

# =========================
# 根据触发次数获取本轮4个视频
# 第1次 -> 1-1 ~ 1-4
# 第2次 -> 2-1 ~ 2-4
# 第3次 -> 3-1 ~ 3-4
# 第4次 -> 4-1 ~ 4-4
# 第5次 -> 再回到1-1 ~ 1-4
# =========================
def get_videos_for_trigger(trigger_count):
    group = (trigger_count - 1) % TOTAL_GROUPS + 1

    return [
        rf"D:\{group}-1.mp4",
        rf"D:\{group}-2.mp4",
        rf"D:\{group}-3.mp4",
        rf"D:\{group}-4.mp4",
    ]

# =========================
# 检查文件是否存在
# =========================
def check_files_exist(file_list):
    missing = [f for f in file_list if not os.path.exists(f)]
    if missing:
        print("以下视频文件不存在：")
        for f in missing:
            print("  ", f)
        return False
    return True

# =========================
# 播放4个视频
# 每个屏幕一个，全部播完后返回
# ESC退出时返回False
# =========================
def play_4_videos(video_list):
    if not check_files_exist(video_list):
        print("本轮触发视频文件不完整，跳过。")
        time.sleep(1)
        return True

    caps = []
    delays = []

    for path in video_list:
        cap = cv2.VideoCapture(path)
        if not cap.isOpened():
            print(f"视频打开失败: {path}")
            for c in caps:
                c.release()
            return True
        caps.append(cap)
        delays.append(get_video_delay(cap))

    global_delay = min(delays)
    finished = [False, False, False, False]
    black = create_black_frame()

    while True:
        all_finished = True
        frames = []

        for i in range(4):
            if not finished[i]:
                ret, frame = caps[i].read()
                if ret:
                    frame = cv2.resize(frame, (SCREEN_W, SCREEN_H))
                    frames.append(frame)
                    all_finished = False
                else:
                    finished[i] = True
                    frames.append(black)
            else:
                frames.append(black)

        show_frames(frames)

        key = cv2.waitKey(global_delay) & 0xFF
        if key == 27:   # ESC
            for cap in caps:
                cap.release()
            return False

        if all_finished:
            break

    for cap in caps:
        cap.release()

    return True

# =========================
# 主程序
# 待机时4屏循环播放传送带-空
# 触发时按组播放 group-1 ~ group-4
# =========================
def main():
    create_windows()
    ser = open_serial()

    if not os.path.exists(IDLE_VIDEO):
        print(f"待机视频不存在: {IDLE_VIDEO}")
        return

    cap_idle = cv2.VideoCapture(IDLE_VIDEO)
    if not cap_idle.isOpened():
        print(f"待机视频打开失败: {IDLE_VIDEO}")
        return

    delay_idle = get_video_delay(cap_idle)
    last_trigger_time = 0
    trigger_count = 0

    print("程序启动成功")
    print(f"待机视频: {IDLE_VIDEO}")
    print(f"触发距离 < {TRIGGER_DISTANCE}")
    print("触发组顺序: 1组 -> 2组 -> 3组 -> 4组 -> 循环")
    print("按 ESC 退出")

    try:
        while True:
            # =========================
            # 待机视频循环播放
            # =========================
            ret, frame = cap_idle.read()
            if not ret:
                cap_idle.set(cv2.CAP_PROP_POS_FRAMES, 0)
                continue

            frame = cv2.resize(frame, (SCREEN_W, SCREEN_H))
            show_frames([frame, frame, frame, frame])

            # =========================
            # 读取距离
            # =========================
            distance, ser = get_distance_safe(ser)

            trigger = False
            if distance is not None:
                now = time.time()
                if distance < TRIGGER_DISTANCE and (now - last_trigger_time) > TRIGGER_COOLDOWN:
                    trigger = True
                    last_trigger_time = now

            # =========================
            # ESC退出
            # =========================
            key = cv2.waitKey(delay_idle) & 0xFF
            if key == 27:
                print("ESC退出")
                break

            # =========================
            # 触发播放
            # =========================
            if trigger:
                trigger_count += 1
                current_videos = get_videos_for_trigger(trigger_count)

                print(f"第 {trigger_count} 次触发")
                print("屏1:", current_videos[0])
                print("屏2:", current_videos[1])
                print("屏3:", current_videos[2])
                print("屏4:", current_videos[3])

                ok = play_4_videos(current_videos)
                if not ok:
                    print("ESC退出")
                    break

                print("本轮播放结束，返回待机视频。")

                try:
                    ser.reset_input_buffer()
                except:
                    pass

                cap_idle.set(cv2.CAP_PROP_POS_FRAMES, 0)

    finally:
        try:
            cap_idle.release()
        except:
            pass

        try:
            ser.close()
        except:
            pass

        cv2.destroyAllWindows()
        print("程序已关闭")

if __name__ == "__main__":
    main()
