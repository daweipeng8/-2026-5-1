    (15,  671,   455, 524, "模块投影键盘.mp4",  ["KB_PRESS"]),                 # 机械键盘
    (1462, 67,   449, 525, "模块投影盖章.mp4", ["HALL1_ON"]),                  # 霍尔1
    (1460,    694, 450, 520, "模块投影冰箱.mp4",  ["HALL2_OFF"]),                 # 霍尔2
    (728,  65, 465, 525, "模块投影六边形.mp4",  ["PRESSURE_ON"]),               # 压敏电阻
    (29, 70, 420, 506, "模块投影座椅.mp4",  ["SWITCH_ON", "SWITCH_OFF"]),   # 开关
