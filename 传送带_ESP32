#include <Arduino.h>
#include <Wire.h>
#include "Adafruit_VL53L0X.h"

static const int I2C_SDA = 2;
static const int I2C_SCL = 1;

Adafruit_VL53L0X lox;

bool initVL53L0X()
{
    // 多次重试
    for (int i = 0; i < 5; i++) {
        Serial.printf("VL53L0X init try %d...\n", i + 1);

        if (lox.begin()) {
            Serial.println("VL53L0X init OK");
            return true;
        }

        Serial.println("VL53L0X init failed, retry...");
        delay(200);
    }

    return false;
}

void setup()
{
    Serial.begin(115200);
    delay(1000);

    Serial.println("System start");

    // 上电后先等一会
    delay(200);

    Wire.begin(I2C_SDA, I2C_SCL);
    Wire.setClock(100000);   // 先用100k，稳一点
    delay(200);

    if (!initVL53L0X()) {
        Serial.println("VL53L0X init FAILED after retries");
        while (1) {
            delay(1000);
        }
    }
}

void loop()
{
    VL53L0X_RangingMeasurementData_t measure;
    lox.rangingTest(&measure, false);

    if (measure.RangeStatus != 4) {
        Serial.println(measure.RangeMilliMeter);
    }

    delay(50);
}
